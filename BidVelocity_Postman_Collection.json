{
	"info": {
		"_postman_id": "b7d1e8c4-9a2f-4c5e-8b3d-1a9f0e2d4c5b",
		"name": "BidVelocity - Complete Microservices API & JWT Test Suite",
		"description": "Full end-to-end API test suite for BidVelocity. Pre-configured with automated JWT token extraction, dual-token rotation, RBAC validation, concurrency-protected bidding, and admin operations.\n\nWorks with both:\n1. Live Production: https://bidvelocity-backend.onrender.com\n2. Local Microservices Gateway: http://localhost:8080",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication & Security (Review 1 & 2)",
			"item": [
				{
					"name": "01. Register New User (201 Created)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"reviewer_{{$timestamp}}@bidvelocity.io\",\n  \"password\": \"SecurePass123!\",\n  \"name\": \"Postman Evaluator\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Registers a new user. Returns HTTP 201 Created with JWT access token and refresh token."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var data = pm.response.json();",
									"if (data.token) {",
									"    pm.environment.set('jwt_token', data.token);",
									"    console.log('Auto-saved JWT Token: ' + data.token);",
									"}",
									"if (data.refreshToken) {",
									"    pm.environment.set('refresh_token', data.refreshToken);",
									"    console.log('Auto-saved Refresh Token: ' + data.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "02. Login Admin (Auto-Captures JWT & Refresh Token)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@bidvelocity.io\",\n  \"password\": \"AdminPassword123!\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Authenticates the Admin user. The Postman Test Script automatically captures 'token' into {{jwt_token}} and 'refreshToken' into {{refresh_token}} for all subsequent requests."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"pm.test('Contains Token and Roles', function () {",
									"    pm.expect(data.token).to.be.a('string');",
									"    pm.expect(data.refreshToken).to.be.a('string');",
									"    pm.expect(data.user.roles).to.include('ADMIN');",
									"});",
									"pm.environment.set('jwt_token', data.token);",
									"pm.environment.set('refresh_token', data.refreshToken);",
									"pm.environment.set('user_id', data.user.id);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "03. Refresh Token (Family-Based Rotation & Breach Detection)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/auth/refresh",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "refresh"]
						},
						"description": "Demonstrates Dual-Token Family Rotation. The old refresh token is invalidated and a new one is issued with the same family ID. If a stolen token is replayed, all tokens in the family are revoked."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"pm.environment.set('jwt_token', data.token);",
									"pm.environment.set('refresh_token', data.refreshToken);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "04. Forgot Password (Dispatches Real OTP to Gmail)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"harharmahdev003@gmail.com\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/auth/forgot-password",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "forgot-password"]
						},
						"description": "Triggers the real-time Google SMTP OTP dispatcher over Port 443. Notice: zero OTP code is returned in the HTTP response, guaranteeing zero leak security."
					}
				},
				{
					"name": "05. Reset Password (Verify Code & Update)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"harharmahdev003@gmail.com\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPassword123!\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/auth/reset-password",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "reset-password"]
						}
					}
				},
				{
					"name": "06. Logout (Invalidates Refresh Token)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "logout"]
						}
					}
				}
			]
		},
		{
			"name": "02. User Profiles & Role Escalation",
			"item": [
				{
					"name": "01. Get Authenticated User Profile (Me)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/users/me",
							"host": ["{{base_url}}"],
							"path": ["api", "users", "me"]
						},
						"description": "Validates the Bearer JWT token against the Gateway and returns the user identity claims."
					}
				},
				{
					"name": "02. Become Seller (Upgrade Account)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/users/me/seller",
							"host": ["{{base_url}}"],
							"path": ["api", "users", "me", "seller"]
						},
						"description": "Elevates the authenticated user to 'SELLER' and returns a fresh JWT with updated role claims."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var d = pm.response.json();",
									"    pm.environment.set('jwt_token', d.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "03. Auction Marketplace (Review 1 & 3)",
			"item": [
				{
					"name": "01. Search & Browse Marketplace",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auctions?page=0&size=12&sort=endTime",
							"host": ["{{base_url}}"],
							"path": ["api", "auctions"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "12" },
								{ "key": "sort", "value": "endTime" }
							]
						},
						"description": "Public marketplace endpoint supporting full-text search, category filtering, and pagination."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var data = pm.response.json();",
									"if (data.content && data.content.length > 0) {",
									"    pm.environment.set('auction_id', data.content[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "02. Get Auction By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auctions/{{auction_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "auctions", "{{auction_id}}"]
						}
					}
				},
				{
					"name": "03. Create Auction Lot (Seller/Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Postman Luxury Timepiece #{{$timestamp}}\",\n  \"description\": \"Automated test auction lot created via Postman test suite.\",\n  \"category\": \"Luxury\",\n  \"startingPrice\": 500.00,\n  \"minIncrement\": 25.00,\n  \"durationMinutes\": 60\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/auctions",
							"host": ["{{base_url}}"],
							"path": ["api", "auctions"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var lot = pm.response.json();",
									"    pm.environment.set('auction_id', lot.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "04. Get My Created Listings",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/auctions/mine",
							"host": ["{{base_url}}"],
							"path": ["api", "auctions", "mine"]
						}
					}
				}
			]
		},
		{
			"name": "04. Real-Time Bidding & Concurrency (Review 2 & 3)",
			"item": [
				{
					"name": "01. Place Bid (Concurrency Protected)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"auctionId\": {{auction_id}},\n  \"amount\": 550.00,\n  \"idempotencyKey\": \"pm-bid-{{$timestamp}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/bids",
							"host": ["{{base_url}}"],
							"path": ["api", "bids"]
						},
						"description": "Places a bid protected by pessimistic row-level locking (SELECT ... FOR UPDATE) and atomic Compare-And-Swap acceptance."
					}
				},
				{
					"name": "02. Get Bid History for Auction",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/bids/auction/{{auction_id}}?size=30",
							"host": ["{{base_url}}"],
							"path": ["api", "bids", "auction", "{{auction_id}}"],
							"query": [{ "key": "size", "value": "30" }]
						}
					}
				},
				{
					"name": "03. Get My Bids History",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/bids/my",
							"host": ["{{base_url}}"],
							"path": ["api", "bids", "my"]
						}
					}
				}
			]
		},
