			]
		},
		{
			"name": "06. Admin Operations & Surveillance (Review 1, 2, 3)",
			"item": [
				{
					"name": "01. Admin Platform Overview Statistics",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/admin/stats",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "stats"]
						},
						"description": "Returns platform telemetry: GMV, live/closed auctions, user counts, and settled volumes."
					}
				},
				{
					"name": "02. Admin List All Users",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/admin/users",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users"]
						}
					}
				},
				{
					"name": "03. Admin Suspend User (Triggers Family Revocation)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"SUSPENDED\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/admin/users/{{user_id}}/status",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users", "{{user_id}}", "status"]
						}
					}
				},
				{
					"name": "04. Admin Activate User",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"ACTIVE\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/api/admin/users/{{user_id}}/status",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users", "{{user_id}}", "status"]
						}
					}
				},
				{
					"name": "05. Admin Real-Time Bidding Feed",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/api/admin/bids?size=50",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "bids"],
							"query": [{ "key": "size", "value": "50" }]
						}
					}
				}
			]
		},
		{
			"name": "07. System Health & Service Discovery (Review 1 & 2)",
			"item": [
